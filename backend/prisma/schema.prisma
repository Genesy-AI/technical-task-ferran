generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  phoneNumber String?
  yearsInRole Int?
  linkedinUrl String?
  message     String?
  emailVerified Boolean?
  // Phone enrichment bookkeeping. System fields, not user-settable, so they stay out of
  // LEAD_FIELDS — same treatment as emailVerified.
  phoneStatus    String?   // running | found | not_found | failed
  phoneProvider  String?   // orionConnect | astraDialer | nimbusLookup
  phoneCheckedAt DateTime?
}
